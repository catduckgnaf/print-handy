# Generic Hermes profile config for Print Handy.
# Dollar-brace placeholders are filled by scripts/install-hermes.sh from the environment (see docs/INSTALL.md).
# Anything it cannot fill stays as a placeholder; set it in config/overlay/config.yaml, which replaces this file.
# Never put tokens here. Secrets belong in the profile .env.

model:
  provider: ${LLM_PROVIDER}
  default: ${LLM_MODEL}
  api_mode: chat_completions
  base_url: ${LLM_BASE_URL}
providers:
  ${LLM_PROVIDER}:
    base_url: ${LLM_BASE_URL}
    api_mode: chat_completions
    key_env: LLM_API_KEY
    request_timeout_seconds: 90
    stale_timeout_seconds: 60
# Auxiliary tasks: models Hermes calls for side jobs, separate from the chat
# model above. Uncomment print_design to give /print-design (#388) a stronger
# model than chat; chat itself stays on the profile model. Note: a configured
# Print Handy [design] (or inherited [llm]) endpoint takes precedence over
# this pin (#524) — print_design here is the fallback for a Hermes install
# with no endpoint configured. The design timeout comes from Print Handy's
# [design] timeout_s, not from here.
# auxiliary:
#   print_design:
#     provider: ${LLM_PROVIDER}
#     model: sol
#     reasoning_effort: medium
agent:
  api_max_retries: 3
  reasoning_effort: medium
  verbose: false
  max_turns: 200
compression:
  threshold_tokens: 120000
  idle_compact_after_seconds: 900
display:
  interim_assistant_messages: false
  memory_notifications: 'off'
  platforms:
    discord:
      tool_progress: 'off'
      interim_assistant_messages: false
      long_running_notifications: generic
      streaming: false
      show_reasoning: false
memory:
  memory_enabled: true
  user_profile_enabled: false
timezone: ${TIMEZONE}
discord:
  require_mention: true
  free_response_channels: '${DISCORD_CHANNEL_ID}'
  allowed_channels:
  - '${DISCORD_CHANNEL_ID}'
approvals:
  mode: 'off'
  destructive_slash_confirm: false
plugins:
  enabled:
  - print-feedback
  # Optional external plugins, installed separately (see docs/INSTALL.md): image_gen.
  disabled: []
  entries:
    print-feedback:
      allow_tool_override: false
platforms:
  discord:
    enabled: true
    gateway_restart_notification: false
platform_toolsets:
  cli:
  - clarify
  - cronjob
  - file
  - memory
  - session_search
  - skills
  - terminal
  - todo
  - vision
  - web
  discord:
  - clarify
  - discord
  - file
  - memory
  - session_search
  - skills
  - terminal
  - vision
  - web
terminal:
  cwd: ${REPO}
session_reset:
  mode: daily
  at_hour: 4
skills:
  write_approval: true
