# Copy to .env and fill in. All PRINT_HANDY__SECTION__KEY values override config/docker.yaml.
# Lists (orca.command, printer.bed_mm) cannot come from the environment; mount a full YAML or TOML config.
# The one exception is PRINT_HANDY__DELIVERY__METHODS, a comma- or space-separated list (see below).
# A mounted file replaces /app/config/docker.yaml rather than layering on it: copy docker.yaml and edit the copy.
# Optional: PRINT_HANDY_CONFIG=/app/config/docker.toml selects a legacy TOML mount instead of the YAML default.
# See README "All settings" and config/home.yaml for defaults.
# Docker defaults are in config/docker.yaml; config/docker.toml remains supported when explicitly selected.

# --- Services (required for a working install) ---
PRINT_HANDY__SERVICES__MOONRAKER_URL=http://printer.example:7125
# PRINT_HANDY__SERVICES__MOONRAKER_WS_URL=
# Camera still-image source (#294): auto, moonraker, bambu, go2rtc or none.
# PRINT_HANDY__SERVICES__CAMERA_SOURCE=auto
# PRINT_HANDY__SERVICES__CAMERA_SNAPSHOT_URL=
PRINT_HANDY__SERVICES__SPOOLMAN_URL=
# Leave empty: the container uses its bundled Spoolman API at http://127.0.0.1:8000.
# For an existing external instance, set http://spoolman.example:8000 here and
# PRINT_HANDY_BUNDLED_SPOOLMAN=false below. Nothing is migrated either way.
# PRINT_HANDY__SERVICES__OPENVIKING_URL=
# PRINT_HANDY__SERVICES__VISION_CHAT_URL=
# Or point camera checks at your own detector endpoint instead: it receives
# {image, prompt} and answers {verdict, reason} — the contract is in
# docs/SETTINGS.md, "Custom vision endpoint". No API key is sent.
# PRINT_VISION_URL=
# Or point /print-lookup's no-match path at your own semantic-search endpoint:
# it receives {query, candidates} and answers {matches, degraded} — the
# contract is in docs/SETTINGS.md, "Semantic lookup endpoint". Opt-in and
# stateless; local matching always runs first. No API key is sent.
# PRINT_FUZZY_URL=
# PRINT_HANDY__SERVICES__STOCK_API_PORT=8898

# --- Printer ---
# PRINT_HANDY__PRINTER__MODEL=klipper.generic
# PRINT_HANDY__PRINTER__NAME=
# PRINT_HANDY__PRINTER__NOZZLE_DIAMETER_MM=0.4
# PRINT_HANDY__PRINTER__MAX_PRINT_HEIGHT_MM=250
# PRINT_HANDY__PRINTER__FILAMENT_SLOTS=1
# PRINT_HANDY__PRINTER__TOOL_COUNT=1
# PRINT_HANDY__PRINTER__START_MACRO=PRINT_START
# PRINT_HANDY__PRINTER__END_MACRO=PRINT_END

# --- Discord ---
# PRINT_HANDY__DISCORD__CHAT_ID=
# PRINT_HANDY__DISCORD__APPROVAL_USER_ID=
# PRINT_HANDY__DISCORD__UPLOAD_MAX_BYTES=9500000
# PRINT_HANDY__DISCORD__POST_PRINT_QUIET_S=7200
# PRINT_HANDY__DISCORD__DAILY_RESET_HOUR=4
# PRINT_HANDY__DISCORD__TIMEZONE=America/New_York
# PRINT_HANDY__DISCORD__BOT_NAME=Print Handy

# --- Telegram (standalone bot when PRINT_HANDY__BOT__PLATFORM=telegram, #164) ---
# The token itself goes in the TELEGRAM_BOT_TOKEN secret below, never here.
# PRINT_HANDY__TELEGRAM__TOKEN_ENV=TELEGRAM_BOT_TOKEN
# PRINT_HANDY__TELEGRAM__CHAT_ID=
# PRINT_HANDY__TELEGRAM__ALLOWED_USER_IDS=
# PRINT_HANDY__TELEGRAM__APPROVAL_USER_ID=
# PRINT_HANDY__TELEGRAM__UPLOAD_MAX_BYTES=50000000

# --- Matrix (standalone bot when PRINT_HANDY__BOT__PLATFORM=matrix, #164) ---
# The token itself goes in the MATRIX_ACCESS_TOKEN secret below, never here.
# PRINT_HANDY__MATRIX__HOMESERVER_URL=
# PRINT_HANDY__MATRIX__ACCESS_TOKEN_ENV=MATRIX_ACCESS_TOKEN
# PRINT_HANDY__MATRIX__ROOM_ID=
# PRINT_HANDY__MATRIX__ALLOWED_USER_IDS=
# PRINT_HANDY__MATRIX__APPROVAL_USER_ID=
# PRINT_HANDY__MATRIX__BOT_USER_ID=
# PRINT_HANDY__MATRIX__UPLOAD_MAX_BYTES=50000000

# --- Web UI (optional, #286; off by default) ---
# The access token itself goes in the WEBUI_ACCESS_TOKEN secret, never here;
# access_token_env only names that variable.
# PRINT_HANDY__WEBUI__ENABLED=false
# PRINT_HANDY__WEBUI__HOST=127.0.0.1
# PRINT_HANDY__WEBUI__PORT=0
# PRINT_HANDY__WEBUI__ACCESS_TOKEN_ENV=WEBUI_ACCESS_TOKEN
# false turns the access token off entirely, even on a LAN bind; only for a
# network you trust (anyone who can reach the port gets the Web UI).
# PRINT_HANDY__WEBUI__REQUIRE_AUTH=true
# Printer controls stay off unless explicitly enabled; cancel also needs confirm.
# PRINT_HANDY__WEBUI__CONTROLS_ENABLED=false
# PRINT_HANDY__NOTIFY__MQTT_ENABLED=false
# PRINT_HANDY__NOTIFY__MQTT_HOST=
# PRINT_HANDY__NOTIFY__MQTT_PORT=1883
# PRINT_HANDY__NOTIFY__MQTT_TOPIC=print-handy
# PRINT_HANDY__NOTIFY__MQTT_USERNAME=
# MQTT_PASSWORD=
# PRINT_HANDY__NOTIFY__NTFY_ENABLED=false
# PRINT_HANDY__NOTIFY__NTFY_URL=
# PRINT_HANDY__NOTIFY__NTFY_TOPIC=
# NTFY_ACCESS_TOKEN=

# --- Live camera in Discord (optional, #311; off by default) ---
# The Discord client secret and the Activity session secret are secrets
# (DISCORD_CLIENT_SECRET and LIVE_STREAM_SESSION_SECRET, in the secrets
# block below), never settings here. DISCORD_CLIENT_ID is the Discord
# application ID — a plain identifier, not a secret. TUNNEL_TOKEN (also
# below) belongs to the optional cloudflared sidecar only.
# DISCORD_CLIENT_ID=
# PRINT_HANDY__LIVE_STREAM__ENABLED=false
# PRINT_HANDY__LIVE_STREAM__VOICE_CHANNEL_ID=
# PRINT_HANDY__LIVE_STREAM__AUTO_START_ON_PRINT=false
# PRINT_HANDY__LIVE_STREAM__MAX_HEIGHT=720
# PRINT_HANDY__LIVE_STREAM__FPS=15
# PRINT_HANDY__LIVE_STREAM__MAX_BITRATE_KBPS=2500
# PRINT_HANDY__LIVE_STREAM__ENCODER=auto
# PRINT_HANDY__LIVE_STREAM__EMPTY_TIMEOUT_S=300
# PRINT_HANDY__LIVE_STREAM__ACTIVITY_ORIGIN=
# PRINT_HANDY__LIVE_STREAM__PORT=0

# --- Paths (container paths; volumes map host dirs) ---
# PRINT_HANDY__PATHS__HERMES_HOME=/data/hermes
# PRINT_HANDY__PATHS__ARCHIVE=/data/archive
# PRINT_HANDY__PATHS__RECORDS_VAULT=/data/records
# PRINT_HANDY__PATHS__CACHE=/data/cache
# PRINT_HANDY__PATHS__FFMPEG=ffmpeg

# --- Visual watch / listener / vision / timelapse / maintenance ---
# PRINT_HANDY__VISUAL_WATCH__SENSITIVITY=3
# PRINT_HANDY__LISTENER__TICK_S=600
# PRINT_HANDY__VISION__MODEL=gemini-latest
# PRINT_HANDY__VISION__ROAST_MODEL=luna-latest
# PRINT_HANDY__VISION__ROAST_ENABLED=true
# Local failure detector (#455): built-in ONNX detector for the camera
# watchdog when no vision endpoint is configured. Off by default. The
# pinned model (~202 MB) downloads once, SHA-256 verified, into the
# models folder under the Hermes home (or LOCAL_MODEL_PATH).
# PRINT_HANDY__VISION__LOCAL_DETECTOR_ENABLED=false
# PRINT_HANDY__VISION__LOCAL_MODEL_PATH=
# Auto light-off (#516): printer light on at print start, off after the
# plate has been seen empty for this many minutes. 0 = off (default).
# PRINT_HANDY__VISION__AUTO_LIGHT_OFF_MINUTES=0
# Moonraker light object to switch (empty = auto-discover a single one)
# PRINT_HANDY__VISION__LIGHT_OBJECT=
# Ask for brand/vendor in the new-spool walkthrough; off by default (#512)
# PRINT_HANDY__SPOOL__PROMPT_BRAND=false
# PRINT_HANDY__TIMELAPSE__ARCHIVE_HOST=
# PRINT_HANDY__TIMELAPSE__CAPTURE_ENABLED=false
# PRINT_HANDY__TIMELAPSE__CAPTURE_SOURCE_URL=
# PRINT_HANDY__TIMELAPSE__CAPTURE_TRIGGER=interval
# PRINT_HANDY__TIMELAPSE__CAPTURE_INTERVAL_S=5.0
# PRINT_HANDY__TIMELAPSE__CAPTURE_MAX_FRAMES=3600
# PRINT_HANDY__TIMELAPSE__CAPTURE_MAX_BYTES=536870912
# PRINT_HANDY__TIMELAPSE__CAPTURE_ENCODER=auto
# Timelapse sizing-shrink encoder (#314): cpu, vaapi, qsv or nvenc.
# PRINT_HANDY__TIMELAPSE__ENCODER=cpu
# PRINT_HANDY__MAINTENANCE__QUICK_HOURS=25

# Legacy names still accepted (MOONRAKER_URL, SPOOLMAN_URL, ...). See settings.py LEGACY_ENV.

# --- Combined Docker container (required values must be filled before startup) ---
# An empty DISCORD_BOT_TOKEN keeps the bot idle while the listener and Spoolman run.
PRINT_HANDY_IMAGE=
PRINT_HANDY_DATA=./data
# PRINT_HANDY_SPOOLMAN_DATA=./data/spoolman
# PRINT_HANDY_BUNDLED_SPOOLMAN=true
# Bundled Spoolman bind host (#443): 127.0.0.1 (the default) keeps the API
# loopback-only inside the container. Set 0.0.0.0 ONLY together with the
# optional "7912:8000" port mapping in docker-compose.yml, so Moonraker on
# printer hardware or Home Assistant can reach http://<host>:7912. The API
# is unauthenticated: LAN only, never forward it from a router.
# SPOOLMAN_HOST=127.0.0.1
PRINT_HANDY__BOT__MODE=standalone
DISCORD_BOT_TOKEN=
# Telegram bot token, used instead when PRINT_HANDY__BOT__PLATFORM=telegram (#164).
TELEGRAM_BOT_TOKEN=
# Matrix access token, used instead when PRINT_HANDY__BOT__PLATFORM=matrix (#164).
MATRIX_ACCESS_TOKEN=
# Web UI access token (#286): required when the Web UI binds beyond loopback.
WEBUI_ACCESS_TOKEN=
# Live camera in Discord (#311): the Discord application's client secret and
# the Activity session signing secret. Both are required before the live
# gate will start the Activity server; neither is ever a setting.
DISCORD_CLIENT_SECRET=
LIVE_STREAM_SESSION_SECRET=
# Named Cloudflare Tunnel token for the live view (#311): read only by the
# optional cloudflared sidecar (Compose profile "live-stream"); Print Handy
# itself never uses it. CLOUDFLARED_IMAGE names the tested connector image.
TUNNEL_TOKEN=
# CLOUDFLARED_IMAGE=
PRINT_HANDY__DISCORD__CHAT_ID=
# Access (#386): leave ALLOWED empty (the default) and everyone who can post
# in the print channel can use the bot. Set it only to restrict the bot to
# listed users; DENIED always excludes, even a listed or approval user.
PRINT_HANDY__DISCORD__ALLOWED_USER_IDS=
# PRINT_HANDY__DISCORD__DENIED_USER_IDS=
# Container timezone (docs/SETTINGS.md "Compose variables"): IANA name, for example Europe/London.
TZ=America/New_York
# Runtime environment (docs/SETTINGS.md): bundled OrcaSlicer channel selected at startup.
PRINT_HANDY_ORCA_CHANNEL=stable
# APP_CHANNEL, WITH_ORCA and WITH_BAMBU are image BUILD arguments, not settings. Select the bundled Orca build at runtime with PRINT_HANDY_ORCA_CHANNEL=stable (default) or preview (alpha, the old name, is still accepted for now).

# --- Every other scalar setting, commented, with its Docker value (docs/SETTINGS.md) ---
# printer, layout and prime_tower values are the klipper.generic model defaults.
# Lists and tables (orca.command, printer.bed_mm, delivery.methods, material_temps, cold_pull)
# are file-only. Secrets other than the bot token, only when used:
# LLM_API_KEY=
# AGENT_API_KEY=
# OCTOPRINT_API_KEY=
# MOONRAKER_API_KEY=
# BAMBU_LAN_PASSWORD=
# CLIPROXY_API_KEY=
# OPENVIKING_API_KEY=
# Model-site login tokens (docs/PROJECT-REFERENCE.md); a saved ~/.config/<site>/token file wins:
# MAKERWORLD_TOKEN=
# THINGIVERSE_TOKEN=
# CULTS3D_TOKEN=
# CREALITYCLOUD_TOKEN=
# THANGS_TOKEN=
# NEXPRINT_TOKEN=
# MYMINIFACTORY_OAUTH_TOKEN=
# The MakerWorld account token is a file, not a variable: /data/.config/bambu/token (docs/DOCKER.md).
# Stock Flashforge LAN secrets (with PRINT_HANDY__FLASHFORGE_STOCK__HOST above):
# AD5X_SERIAL=
# AD5X_CHECK_CODE=
# Part gap preset: minimum (default), low, medium (Standard, the pre-2.2 gaps) or high.
# It fills the gap keys below; any of them set here wins over the preset.
# PRINT_HANDY__LAYOUT__SPACING=minimum
# PRINT_HANDY__LAYOUT__SINGLE_COPY_EDGE_MM=1.0
# PRINT_HANDY__LAYOUT__MULTI_COPY_EDGE_MM=3.0
# PRINT_HANDY__LAYOUT__ARRANGE_GAP_MM=2.0
# PRINT_HANDY__LAYOUT__ARRANGE_EDGE_MM=1.0
# PRINT_HANDY__LAYOUT__MERGE_EDGE_MARGIN_MM=1.0
# PRINT_HANDY__LAYOUT__MERGE_SPACING_MM=2.0
# PRINT_HANDY__LAYOUT__MAX_MERGED_HOURS=12
# PRINT_HANDY__PRIME_TOWER__SIZE_MM=45.0
# PRINT_HANDY__PRIME_TOWER__PART_CLEARANCE_MM=3.5
# PRINT_HANDY__PRIME_TOWER__EDGE_MM=4.0
# PRINT_HANDY__PRIME_TOWER__MERGE_SLACK_MM=1.0
# PRINT_HANDY__PRINTER__FIRMWARE=Klipper
# PRINT_HANDY__PRINTER__VENDOR=klipper
# PRINT_HANDY__PRINTER__SLICER=orca
# ZMod delivery format (#564; Flashforge/ZMod printers only — refused under the
# generic default above): auto sends .gcode.3mf at ZMod 1.7.5+, else .gcode.
# PRINT_HANDY__PRINTER__ZMOD_DELIVERY_FORMAT=auto
# Optional user-installed Flash Studio executable. Empty keeps OrcaSlicer.
# PRINT_HANDY__SLICER__FLASH_STUDIO_PATH=
# Stock Flashforge LAN. Empty host leaves the printer offline. The serial and
# check code are secrets (AD5X_SERIAL, AD5X_CHECK_CODE), never settings.
# PRINT_HANDY__FLASHFORGE_STOCK__HOST=
# PRINT_HANDY__PRINTER__NOZZLE_TYPE=
# PRINT_HANDY__ORCA__TEMPLATES=
# PRINT_HANDY__PATHS__HERMES_BIN=/usr/local/bin/hermes
# PRINT_HANDY__PATHS__HERMES_AGENT=/data/hermes/hermes-agent
# PRINT_HANDY__PATHS__HERMES_RESTART_HELPER=/data/hermes/restart_hermes.py
# PRINT_HANDY__SERVICES__OCTOPRINT_URL=
# Bambu Lab read-only LAN status (#187): set host and serial together; the access code
# itself goes in the BAMBU_LAN_PASSWORD secret below, never in a setting.
# PRINT_HANDY__BAMBU__LAN_HOST=
# PRINT_HANDY__BAMBU__LAN_SERIAL=
# PRINT_HANDY__BAMBU__LAN_ACCESS_CODE_ENV=BAMBU_LAN_PASSWORD
# PRINT_HANDY__BAMBU__START_CONFIRM_S=90
# Post-slice delivery methods, comma- or space-separated, from the vendor profile (#270). `printer` is
# the Bambu LAN print opt-in: it adds the Start button and is never a default. A value the vendor does
# not offer stops startup; empty keeps the file value.
# PRINT_HANDY__DELIVERY__METHODS=discord,bambu_handoff,printer
# PrusaLink (#242): plain printer host, no scheme or port. The API key itself is
# the PRUSA_LINK_API_KEY secret, never a setting; API_KEY_ENV only names the
# variable that holds it.
# PRINT_HANDY__PRUSA__LINK_HOST=
# PRINT_HANDY__PRUSA__API_KEY_ENV=PRUSA_LINK_API_KEY
# Elegoo SDCP (#243, Centauri line): plain printer host, no scheme or port.
# SDCP has no authentication, so there is no key to set.
# PRINT_HANDY__ELEGOO_SDCP__HOST=
# PRINT_HANDY__DISCORD__QUESTION_TIMEOUT_S=1800
# PRINT_HANDY__DISCORD__SAFETY_CONFIRM_TIMEOUT_S=600
# PRINT_HANDY__DISCORD__UPLOAD_WAIT_S=3600
# PRINT_HANDY__DISCORD__COLD_PULL_OUTCOME_S=1800
# PRINT_HANDY__DISCORD__TOKEN_ENV=DISCORD_BOT_TOKEN
# Discord chat LLM (#466): true by default. false runs Discord as a pure bot
# (unmatched text gets the short not-understood reply) while the LLM below stays set up
# for /print-design, which inherits it.
# PRINT_HANDY__DISCORD__CHAT_LLM_ENABLED=true
# Discord clarify UI (#524 stage 2): false by default — on a Hermes install Hermes'
# adapter draws Print Handy's questions, as before. true makes Print Handy draw them
# itself (own prompt registry, direct Discord REST), one renderer in both modes.
# PRINT_HANDY__DISCORD__CLARIFY_UI=false
# PRINT_HANDY__BOT__PLATFORM=discord
# PRINT_HANDY__BOT__HEALTH_PORT=0
# PRINT_HANDY__BOT__HEALTH_STALE_S=120
# PRINT_HANDY__BOT__SYNC_COMMANDS=true
# PRINT_HANDY__LLM__CHAT_URL=
# PRINT_HANDY__LLM__MODEL=
# PRINT_HANDY__LLM__API_KEY_ENV=LLM_API_KEY
# PRINT_HANDY__LLM__TIMEOUT_S=20
# Stray-chat agent lane (#524 stage 3): an agent endpoint (any
# OpenAI-compatible chat completions URL, e.g. a Hermes agent behind its
# API) answers Discord free text ahead of the LLM call above. Empty
# CHAT_URL: no agent lane. MODEL is optional; empty omits it from the
# request. The endpoint's replies are posted as-is and can never run a
# command. PRINT_HANDY__DISCORD__CHAT_LLM_ENABLED=false turns this off too.
# PRINT_HANDY__AGENT__CHAT_URL=
# PRINT_HANDY__AGENT__MODEL=
# PRINT_HANDY__AGENT__API_KEY_ENV=AGENT_API_KEY
# PRINT_HANDY__AGENT__TIMEOUT_S=120
# AI design with OpenSCAD (#388): auto-on whenever a design/LLM endpoint
# is configured (the LLM values above count), like roasts — there is no
# ENABLED line to set for that. Empty CHAT_URL/MODEL/API_KEY_ENV inherit
# the LLM values above, so a single-endpoint setup only sets MODEL (a
# stronger model for design turns). Set ENABLED=false to force design off,
# or ENABLED=true to force it on (an endpoint is still required).
# PRINT_HANDY__DESIGN__ENABLED=
# PRINT_HANDY__DESIGN__CHAT_URL=
# PRINT_HANDY__DESIGN__MODEL=
# PRINT_HANDY__DESIGN__API_KEY_ENV=
# PRINT_HANDY__DESIGN__TIMEOUT_S=180
# PRINT_HANDY__DESIGN__REPAIR_ATTEMPTS=3
# PRINT_HANDY__LISTENER__IFS_PRESENCE_POLL_S=15
# PRINT_HANDY__LISTENER__SPOOL_NAG_S=600
# PRINT_HANDY__LISTENER__START_CLAIM_TTL_S=1800
# PRINT_HANDY__VISUAL_WATCH__ENABLED=true
# Timelapse mode (#246/#295): rendered, container or off. Empty derives
# rendered when a Moonraker URL is configured, else off.
# PRINT_HANDY__TIMELAPSE__MODE=rendered
# PRINT_HANDY__TIMELAPSE__ARCHIVE_DIR=
# PRINT_HANDY__TIMELAPSE__SSH_KEY=
# PRINT_HANDY__TIMELAPSE__RENDER_WAIT_S=900
# PRINT_HANDY__TIMELAPSE__RENDER_POLL_S=10
# PRINT_HANDY__TIMELAPSE__MAX_BYTES=209715200
# PRINT_HANDY__TIMELAPSE__LOCAL_RETENTION_DAYS=1
# PRINT_HANDY__TIMELAPSE__PLAN_CLIP_RETENTION_DAYS=14
# PRINT_HANDY__TIMELAPSE__VERTICAL_SHORT=false
# PRINT_HANDY__TIMELAPSE__VERTICAL_SHORT_MODE=pad
# PRINT_HANDY__TIMELAPSE__VERTICAL_SHORT_OVERLAY=true
# PRINT_HANDY__LOGGING__LEVEL=INFO
# PRINT_HANDY__LOGGING__FORMAT=text
# PRINT_HANDY__LOGGING__FILE=
# PRINT_HANDY__MAINTENANCE__FULL_HOURS=75
# PRINT_HANDY__MAINTENANCE__FULL_DAYS=30
