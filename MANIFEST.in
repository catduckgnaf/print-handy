# Ship the package's runtime data files in the sdist as well as the wheel:
# print_handy reads them via Path(__file__) (Orca templates, data files,
# HMS data, the Bambu CA bundle, the Wrapped music track).
recursive-include print_handy *.json *.toml *.pem *.md *.js *.mp3
include LICENSE NOTICE
# The accelerator is compiled into the Linux wheel, not stored as a binary in the sdist.
include native/paint_census/Cargo.toml native/paint_census/Cargo.lock
include native/paint_census/pyproject.toml native/paint_census/rust-toolchain.toml native/paint_census/README.md
recursive-include native/paint_census/src *.rs
# The bot's command handlers live outside the package (plugins/print-feedback)
# and are loaded by path at startup; the sdist must carry them (#1146).
# Removed with the plugin file in 2.4.0 (docs/PROJECT-REFERENCE.md,
# Scheduled removals in 2.4.0).
include plugins/print-feedback/__init__.py
