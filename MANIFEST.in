# Ship the package's runtime data files in the sdist as well as the wheel:
# print_handy reads them via Path(__file__) (Orca templates, data files,
# HMS data, the Bambu CA bundle).
recursive-include print_handy *.json *.toml *.pem *.md *.js
include LICENSE NOTICE
# The bot's command handlers live outside the package (plugins/print-feedback)
# and are loaded by path at startup; the sdist must carry them (#1146).
include plugins/print-feedback/__init__.py
