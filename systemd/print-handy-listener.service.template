[Unit]
Description=Print Handy Moonraker listener, standalone (posts over Discord REST, no Hermes)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=PRINT_HANDY__BOT__MODE=standalone
EnvironmentFile=-{{DATA_HOME}}/.env
WorkingDirectory={{REPO}}
ExecStart={{PYTHON}} -m print_handy.runtime.moonraker_event_listener
Restart=always
RestartSec=10
MemoryMax=256M
Nice=5

[Install]
WantedBy=default.target
